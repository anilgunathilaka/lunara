    "next": "^16.4.5",
    "next-intl": "^4.13.2",
    "pg": "^8.23.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-email": "^6.9.0",
    "react-hook-form": "^7.82.0",
