{
  "name": "lunara",
  "version": "0.1.0",
  "private": true,
  "description": "Lunara Sarees — premium Sri Lankan cotton saree brand with a Design Your Own Saree configurator.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:worker": "node scripts/check-deploy-env.mjs pre && opennextjs-cloudflare build && node scripts/check-deploy-env.mjs post",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint . && npm run lint:tokens",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@hookform/resolvers": "^5.4.0",
    "@opennextjs/cloudflare": "^1.20.16",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-email/components": "^1.0.12",
    "better-auth": "^1.7.18",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "next": "^16.4.5",
    "next-intl": "^4.13.2",
    "pg": "^8.23.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-email": "^6.9.0",
    "react-hook-form": "^7.82.0",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "prisma": "^7.10.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.158.0"
  }
}
