// Lunara Sarees — Prisma schema
//
// - Better Auth's core tables (User, Session, Account, Verification), so
//   account creation "after purchase, never before" (PRD FR-33) has
//   somewhere to live.
// - The catalogue (docs/4-architecture.md §3, implementation rules §3.3):
//   designs, materials, colourways, PRICE_MATRIX, STOCK_ITEM, curated
//   listings. CONFIGURED_DESIGN and orders arrive with the configurator
//   save/share and checkout features.

generator client {
  provider        = "prisma-client-js"
  // One SQL query per page load: the Worker is ~300 ms from the database,
  // so per-relation round trips would multiply page latency (§3.3).
  previewFeatures = ["relationJoins"]
}

// Supabase-hosted Postgres (docs/4-architecture.md §2.2).
// Prisma 7: connection URLs no longer live here.
//   - CLI (migrate, diff): prisma.config.ts → DIRECT_URL (session pooler).
//   - Runtime: lib/prisma.ts passes a connection string to the pg driver
//     adapter — Hyperdrive on the Worker, DATABASE_URL locally.
datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id         String @id @default(cuid())
  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ─── Catalogue (docs/4-architecture.md §3, §3.3) ─────────────────────────

enum Occasion {
  office
  everyday
  festive
  temple
}

enum Opacity {
  opaque
  semi_sheer
  sheer
}

/// A pattern and its placement. Recolourable: colour lives on the
/// colourway, never here (CLAUDE.md non-negotiable).
model SareeDesign {
  id              String     @id
  name            String
  patternAssetUrl String?
  placementMap    Json?
  occasionTags    Occasion[]
  active          Boolean    @default(true)
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  prices     PriceMatrix[]
  colourways SareeColourway[]

  @@map("saree_design")
}

/// A saree category (PRD v4.0, founder decision 2026-11-14): Cotton,
/// Handloom, Batik, Hand painting, and any the admin adds. The table and
/// model keep their old names (cotton_material, CottonMaterial, materialId);
/// Plain and Super stay as inactive rows because past orders point at them.
/// codePrefix is the product-code prefix (LSC, LSH, LSB, LSHP …) and
/// nextNumber the next running number it hands out (docs/4-architecture.md §3.1).
model CottonMaterial {
  id                String   @id
  name              String
  gsm               Int
  opacity           Opacity
  lengthMetres      Decimal  @db.Decimal(4, 2)
  textureOverlayUrl String?
  codePrefix        String?  @unique
  nextNumber        Int      @default(1)
  sortOrder         Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  prices     PriceMatrix[]
  colourways SareeColourway[]

  @@map("cotton_material")
}

/// THE price source (CLAUDE.md non-negotiable). Saree price for a design in
/// a material, in whole LKR. The customer price adds the paired jacket
/// material's add-on — see lib/pricing/resolve.ts, the only place that sums.
model PriceMatrix {
  designId   String
  materialId String
  price      Int
  updatedAt  DateTime @updatedAt

  design     SareeDesign      @relation(fields: [designId], references: [id], onDelete: Restrict)
  material   CottonMaterial   @relation(fields: [materialId], references: [id], onDelete: Restrict)
  colourways SareeColourway[]

  @@id([designId, materialId])
  @@map("price_matrix")
}

/// A design in a material in a colour: one stock line (§3.2).
model SareeColourway {
  id                String   @id
  designId          String
  materialId        String
  colourName        String
  colourHex         String
  lotId             String
  referenceFrameUrl String?
  galleryAssets     String[] @default([])
  sku               String   @unique
  /// Archived colourways are hidden from the shop, configurator and checkout
  /// but kept with their history (docs/4-architecture.md §3.10).
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  design   SareeDesign      @relation(fields: [designId], references: [id], onDelete: Restrict)
  material CottonMaterial   @relation(fields: [materialId], references: [id], onDelete: Restrict)
  /// Every colourway is priced: no matrix row, no colourway (§3.3).
  price    PriceMatrix      @relation(fields: [designId, materialId], references: [designId, materialId], onDelete: Restrict)
  stock    StockItem        @relation("SareeColourwayStock", fields: [sku], references: [sku], onDelete: Restrict)
  listings CuratedListing[]

  @@unique([designId, materialId, colourName])
  @@map("saree_colourway")
}

/// Jacket material, sold paired (pairingAddOn) or standalone
/// (standalonePrice). Whole LKR. Always ships unstitched.
model JacketMaterial {
  id                String   @id
  name              String
  composition       String
  pieceLengthMetres Decimal  @db.Decimal(4, 2)
  pairingAddOn      Int      @default(0)
  standalonePrice   Int
  textureTileUrl    String?
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  colourways JacketColourway[]

  @@map("jacket_material")
}

model JacketColourway {
  id             String   @id
  materialId     String
  colourName     String
  colourHex      String
  lotId          String
  swatchUrl      String?
  textureTileUrl String?
  sku            String   @unique
  /// Archived jacket colours are hidden from sale but kept with their history.
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  material JacketMaterial   @relation(fields: [materialId], references: [id], onDelete: Restrict)
  stock    StockItem        @relation("JacketColourwayStock", fields: [sku], references: [sku], onDelete: Restrict)
  listings CuratedListing[]

  @@unique([materialId, colourName])
  @@map("jacket_colourway")
}

/// Single source of truth for availability (§3.2). State (in/low/out) is
/// derived from quantity and threshold, never stored (§3.3).
model StockItem {
  sku       String   @id
  quantity  Int
  threshold Int      @default(3)
  updatedAt DateTime @updatedAt

  sareeColourway  SareeColourway?  @relation("SareeColourwayStock")
  jacketColourway JacketColourway? @relation("JacketColourwayStock")
  cost            ProductCost?
  movements       StockMovement[]

  @@map("stock_item")
}

/// What one unit of a SKU costs Lunara to make and bring in, whole LKR
/// (docs/4-architecture.md §3.11). Staff-only; never shown to customers and
/// never part of a customer price. History lives in audit_log.
model ProductCost {
  sku            String   @id
  fabric         Int      @default(0)
  otherMaterials Int      @default(0)
  sewing         Int      @default(0)
  transport      Int      @default(0)
  other          Int      @default(0)
  note           String?
  updatedBy      String
  updatedAt      DateTime @updatedAt

  stock StockItem @relation(fields: [sku], references: [sku], onDelete: Cascade)

  @@map("product_cost")
}

/// Why a stock quantity changed (docs/4-architecture.md §3.12).
enum StockMovementKind {
  opening        /// balance carried in when the ledger started
  created        /// starting quantity of a new product
  adjustment     /// staff adjustment on the Inventory page, with a reason
  online_sale    /// a website order took it
  online_cancel  /// a cancelled website order put it back
  office_sale    /// sold in the office
  office_return  /// an office sale reversed
}

/// Append-only ledger of every stock change, written in the same
/// transaction as the change itself (docs/4-architecture.md §3.12).
/// stock_item.quantity stays the single source of availability; this
/// explains how it got there.
model StockMovement {
  id        String            @id @default(cuid())
  sku       String
  kind      StockMovementKind
  delta     Int
  /// stock_item.quantity right after this movement
  balance   Int
  /// order or office sale number, when there is one
  reference String?
  note      String?
  actor     String
  createdAt DateTime          @default(now())

  stock StockItem @relation(fields: [sku], references: [sku], onDelete: Cascade)

  @@index([sku, createdAt])
  @@index([createdAt])
  @@map("stock_movement")
}

// ── Office sales (docs/4-architecture.md §3.13) ─────────────────────────────

enum OfficeSaleStatus {
  active
  cancelled
}

enum OfficePaymentMethod {
  cash
  bank_transfer
  card
  other
}

/// A customer who buys in the office. Found again by phone.
model OfficeCustomer {
  id        String   @id @default(cuid())
  name      String
  /// Normalised Sri Lankan mobile, +947XXXXXXXX.
  phone     String   @unique
  address   String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales OfficeSale[]

  @@map("office_customer")
}

/// A sale made in the office, paid in one or more instalments. Prices come
/// from the same resolver as the shop; any discount carries its reason.
/// Paid and outstanding are always derived from payments, never stored.
model OfficeSale {
  id             String           @id @default(cuid())
  number         String           @unique
  customerId     String
  status         OfficeSaleStatus @default(active)
  soldOn         DateTime         @db.Date
  subtotal       Int
  discount       Int              @default(0)
  discountReason String?
  total          Int
  note           String?
  soldBy         String
  cancelledAt    DateTime?
  cancelledBy    String?
  cancelReason   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  customer    OfficeCustomer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines       OfficeSaleLine[]
  instalments OfficeInstalment[]
  payments    OfficePayment[]

  @@index([status, soldOn])
  @@index([customerId])
  @@map("office_sale")
}

/// Snapshot of what was sold, kept even if the catalogue changes.
model OfficeSaleLine {
  id                String        @id @default(cuid())
  saleId            String
  kind              OrderLineKind
  listingId         String?
  jacketColourwayId String
  sareeSku          String?
  jacketSku         String
  title             String
  unitPrice         Int
  quantity          Int

  sale OfficeSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("office_sale_line")
}

/// One planned payment: how much, by when. Whether it is paid is derived by
/// applying payments to instalments in order.
model OfficeInstalment {
  id      String   @id @default(cuid())
  saleId  String
  seq     Int
  dueDate DateTime @db.Date
  amount  Int

  sale OfficeSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([saleId, seq])
  @@index([dueDate])
  @@map("office_instalment")
}

/// Money received. Never deleted: a mistaken entry is voided with a reason.
model OfficePayment {
  id         String              @id @default(cuid())
  saleId     String
  amount     Int
  method     OfficePaymentMethod
  paidOn     DateTime            @db.Date
  reference  String?
  note       String?
  receivedBy String
  voidedAt   DateTime?
  voidedBy   String?
  voidReason String?
  createdAt  DateTime            @default(now())

  sale OfficeSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([paidOn])
  @@map("office_payment")
}

/// A pairing chosen by Lunara. Holds no stock and no price of its own:
/// both resolve through its colourways (§3.1).
model CuratedListing {
  id                String   @id
  name              String
  /// Unique product code (LSC001 …), generated when the listing is added; never changed.
  productCode       String?  @unique
  sareeColourwayId  String
  jacketColourwayId String
  isFeatured        Boolean  @default(false)
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sareeColourway  SareeColourway  @relation(fields: [sareeColourwayId], references: [id], onDelete: Restrict)
  jacketColourway JacketColourway @relation(fields: [jacketColourwayId], references: [id], onDelete: Restrict)

  @@index([active, sortOrder])
  @@map("curated_listing")
}

// ─── Orders (docs/4-architecture.md §3.4, §7.2) ──────────────────────────

enum OrderStatus {
  placed
  payment_pending
  confirmed
  packed
  dispatched
  delivered
  cancelled
  return_requested
  refunded
  exchanged
}

enum PaymentMethod {
  cod
  bank_transfer
  lankaqr
  card
}

enum OrderLineKind {
  listing
  configured
  jacket
}

enum Drape {
  saree
  osariya
}

model Order {
  id                       String        @id @default(cuid())
  number                   String        @unique
  status                   OrderStatus
  paymentMethod            PaymentMethod
  customerName             String
  phone                    String
  email                    String?
  addressLine              String
  district                 String
  eventDate                DateTime?     @db.Date
  /// NOT NULL: no order exists without the explicit acknowledgement.
  unstitchedAcknowledgedAt DateTime
  subtotal                 Int
  deliveryFee              Int
  codFee                   Int
  total                    Int
  estimateMinDays          Int
  estimateMaxDays          Int
  locale                   String
  /// Set when dispatched (§3.5).
  courier                  String?
  trackingNumber           String?
  /// SHA-256 (hex) of the guest access token; the token itself is never stored.
  accessTokenHash          String
  userId                   String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  lines         OrderLine[]
  events        OrderEvent[]
  notifications Notification[]
  reviews       Review[]

  @@index([status, createdAt])
  @@index([phone])
  @@map("order")
}

model OrderLine {
  id                 String        @id @default(cuid())
  orderId            String
  kind               OrderLineKind
  listingId          String?
  designId           String?
  materialId         String?
  sareeColourwayId   String?
  jacketColourwayId  String
  sareeSku           String?
  jacketSku          String
  drape              Drape?
  /// Snapshot of what the customer saw, kept even if the catalogue changes.
  title              String
  materialName       String?
  sareeColourName    String?
  jacketMaterialName String
  jacketColourName   String
  unitPrice          Int
  quantity           Int

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  review Review?

  @@index([orderId])
  @@map("order_line")
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  /// 'customer', 'system', or a staff identifier.
  actor     String
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_event")
}

// ─── Operations (docs/4-architecture.md §3.5) ────────────────────────────

enum StaffRole {
  admin
}

/// Who may use /ops. Emails are added with `npm run staff:add`, never committed.
model StaffMember {
  email     String    @id
  role      StaffRole @default(admin)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("staff_member")
}

/// Stock and price changes made in /ops: who, what, before, after.
model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  note       String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("audit_log")
}

// ─── Notifications (docs/4-architecture.md §6.1) ─────────────────────────

enum NotificationChannel {
  whatsapp
  sms
  email
}

enum NotificationStatus {
  /// Automatic channel, waiting to be (re)tried.
  pending
  /// No provider for this channel: staff send it from ops.
  manual
  sent
  /// Gave up after retries; shown in ops.
  failed
  /// Order moved on before this was due (e.g. cancelled before a follow-up).
  cancelled
}

/// Transactional outbox: written with the order change that causes it.
model Notification {
  id        String              @id @default(cuid())
  orderId   String
  event     String
  channel   NotificationChannel
  recipient String
  locale    String
  subject   String?
  body      String
  status    NotificationStatus
  attempts  Int                 @default(0)
  /// Not sent before this time (follow-ups are scheduled days ahead).
  dueAt     DateTime            @default(now())
  lastError String?
  sentAt    DateTime?
  sentBy    String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, dueAt])
  @@index([orderId])
  @@map("notification")
}

// ─── Reviews (docs/4-architecture.md §3.8, PRD FR-46) ─────────────────────

enum ReviewStatus {
  published
  /// Only for a recorded reason (personal data, abuse, not about the product),
  /// never for being critical (FR-46).
  hidden
}

/// A verified review: one per order line, only for a delivered order.
model Review {
  id           String       @id @default(cuid())
  orderId      String
  orderLineId  String       @unique
  /// Copied from the line so product pages read reviews without joining orders.
  listingId    String?
  rating       Int
  body         String
  /// First name and district, as the customer chose to show them.
  displayName  String
  district     String
  /// Storage keys (lib/media/photos.ts), at most 3.
  photos       String[]     @default([])
  locale       String
  status       ReviewStatus @default(published)
  hiddenReason String?
  hiddenBy     String?
  /// A public reply from Lunara, shown under the review.
  response     String?
  respondedBy  String?
  respondedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  @@index([listingId, status, createdAt])
  @@index([status, createdAt])
  @@map("review")
}
