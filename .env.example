# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# ── Database: Supabase-hosted Postgres (docs/4-architecture.md §2.2) ──
# Supabase dashboard → Connect. Percent-encode special characters in the
# password (@ → %40, # → %23). Do NOT use the direct host
# db.[PROJECT-REF].supabase.co — it is IPv6-only.
# Local app runtime (lib/prisma.ts, pg driver adapter): transaction pooler, port 6543.
# No ?pgbouncer=true needed — that flag was for Prisma's old query engine.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# Prisma CLI (migrate, diff — prisma.config.ts): session pooler, port 5432.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# For a plain local Postgres instead, set both to e.g.
#   postgresql://user:password@localhost:5432/lunara
# In production the Worker uses the Hyperdrive binding instead of either URL.

# ── Better Auth ──
BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# ── Resend (transactional email — supplementary channel only, never the
# sole notification channel per docs/1-ux.md §3.5 / docs/4-architecture.md §6.1)
RESEND_API_KEY=""

# ── Media storage: Cloudflare R2 (S3-compatible) ──
# Leave R2_ACCOUNT_ID empty in development to use local filesystem storage
# in .blob-storage/ instead — see lib/storage.
# Cloudflare dashboard → R2 → Manage API tokens (Object Read & Write, scoped
# to this bucket).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="lunara-media"
# Public base URL the bucket is served from (custom domain bound to the
# bucket, e.g. https://media.lunarasarees.lk). No trailing slash.
R2_PUBLIC_BASE_URL=""
