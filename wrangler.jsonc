// Cloudflare Workers deployment for Lunara (docs/4-architecture.md §2.1–2.3).
// Built by OpenNext: `npm run preview` (local workerd) / `npm run deploy`.
// Secrets are NOT set here — use `npx wrangler secret put <NAME>`:
//   BETTER_AUTH_SECRET, RESEND_API_KEY
// Hyperdrive replaces DATABASE_URL on the Worker; never set DB URLs here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lunara",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Lets OpenNext call the Worker from within itself (required by the adapter).
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "lunara" }],

  // Supabase Postgres via Hyperdrive, config `lunara-db-direct`
  // (direct host, query caching disabled — §2.2). For `npm run preview`,
  // set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE in .env
  // to your DIRECT_URL (session pooler).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "db19b2b035264d1e96cebb33c7717949" }],

  // next/image optimisation on the Worker. Colour-profile preservation must
  // be verified before real product photography ships (§2.2, §4).
  "images": { "binding": "IMAGES" },

  // Media storage (lib/storage). R2 must first be enabled in the Cloudflare
  // dashboard and the bucket created (`npx wrangler r2 bucket create
  // lunara-media`); then uncomment. Until then lib/storage has no driver in
  // production — nothing uploads media yet.
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "lunara-media" }],

  // Public origin of the app. Change when a custom domain is attached.
  // Add EMAIL_FROM here once a sending domain is verified in Resend, e.g.
  //   "EMAIL_FROM": "Lunara Sarees <hello@lunarasarees.lk>"
  // Without it, sign-in codes cannot be emailed in production.
  "vars": {
    "BETTER_AUTH_URL": "https://lunara.lunarasarees.workers.dev"
  },

  "observability": { "enabled": true }
}
